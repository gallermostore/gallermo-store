PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Local connection example. Use disposable data for test transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/gallermo
# Atlas legacy seedlist format:
# mongodb://HOST1:27017,HOST2:27017,HOST3:27017/gallermo?tls=true&replicaSet=YOUR_SET&authSource=admin&retryWrites=true&w=majority
# Production checkout and local file storage are disabled in code.
CHECKOUT_ENABLED=false
LOCAL_PRIVATE_UPLOADS=false
# Isolated checkout fixtures require a MongoDB replica set, a fee and a governorate allowlist.
# SHIPPING_FEE_EGP=30
# LOCAL_SHIPPING_GOVERNORATES=Cairo,Giza
