PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Use a replica set for local checkout. Use isolated data for test orders.
MONGODB_URI=mongodb://127.0.0.1:27017/gallermo_dev?replicaSet=rs0
# Atlas standard seedlist format:
# mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/gallermo?tls=true&replicaSet=YOUR_SET&authSource=admin&retryWrites=true&w=majority

CHECKOUT_ENABLED=true
# Generate a stable secret (32+ characters). Server only.
CHECKOUT_QUOTE_SECRET=
STORAGE_DRIVER=local
LOCAL_PRIVATE_UPLOADS=true

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gallermostore@gmail.com
SMTP_APP_PASSWORD=
EMAIL_FROM=gallermostore@gmail.com
ADMIN_NOTIFICATION_EMAIL=gallermostore@gmail.com

R2_ACCOUNT_ID=
# Optional endpoint override. Defaults to https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
PUBLIC_MEDIA_BASE_URL=
